{
  "manifest_version": 3,
  "name": "Gemini Custom Layout & Keybinds",
  "version": "1.0",
  "description": "Geminiの入力フォームを拡張し、Enterキーで改行、Ctrl+Enterで送信に変更します。",
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
